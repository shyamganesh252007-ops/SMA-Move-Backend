# ==============================================================================
# SMA-MOVE BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file or production credentials to version control.

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME=SMA-Move
APP_DEBUG=true
APP_URL=http://localhost/sma-move-backend
APP_TIMEZONE=Asia/Kolkata

# Dedicated Application Database Credentials (MariaDB / MySQL)
# IMPORTANT: In production, always use a dedicated non-root account with restricted privileges.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sma_move
DB_USER=sma_app_user
DB_PASS=your_secure_database_password_here
DB_CHARSET=utf8mb4

# API Security and Cryptographic Secret Keys
ADMIN_API_KEY=your_admin_master_api_key_here
# Generate a cryptographically secure 64+ character random hex string for production:
# e.g., php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=your_cryptographically_secure_app_secret_key_here

# Token Lifetime Settings (in seconds)
ACCESS_TOKEN_TTL=86400      # 24 hours
REFRESH_TOKEN_TTL=2592000   # 30 days
PASSWORD_RESET_TTL=3600     # 1 hour

# CORS Configuration (comma-separated list of allowed origins)
# For Android: local emulator (10.0.2.2), local loopback, LAN IP for physical device
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://10.0.2.2,http://172.23.51.176
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,X-Admin-Key
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# Telehealth Approved Domain Allowlist (comma-separated list of approved hostnames)
# In production, list only vetted, contracted telehealth platform domains.
TELEHEALTH_APPROVED_DOMAINS=telehealth.partner-hospital.in,consult.neuro-care.org

# Rate Limiting (attempts per window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900  # 15 minutes
